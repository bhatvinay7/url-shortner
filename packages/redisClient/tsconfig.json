{  
  "extends":"@repo/typescript-config/base.json",
  "compilerOptions":{
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": true,
    "strict":true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,    
    "esModuleInterop": true,
    "paths":{
      "types":["../types/src/*"]
    },
  },
  "include": ["src/*"]
  }


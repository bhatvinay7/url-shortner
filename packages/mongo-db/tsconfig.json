
{  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": true,
    "forceConsistentCasingInFileNames":true,
    "declaration": true, 
    "types": ["node"],   
    "esModuleInterop": true,
    "paths":{
      "types":["../types/src/*"]
    },
  },
  "include": ["src/*"]
  }

